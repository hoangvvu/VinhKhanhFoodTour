@rendermode InteractiveServer

<div class="sidebar p-4" style="background-color: #FFFFFF; min-height: 100vh; display: flex; flex-direction: column; border-right: 1px solid #E2E8F0;">
    <div class="brand-section text-center mb-5 mt-3">
        <div style="font-size: 24px; color: #C8372D; font-weight: bold; letter-spacing: 1px;">VĨNH KHÁNH</div>
        <div style="font-size: 10px; color: #64748B; letter-spacing: 2px;">AUDIO GUIDE ADMIN</div>
    </div>

    <nav class="nav flex-column gap-2">
        <NavLink class="nav-card" href="" Match="NavLinkMatch.All">
            <span class="bi bi-speedometer2"></span><span class="nav-text">Dashboard</span>
        </NavLink>

        @* ── MENU DÀNH RIÊNG CHO ADMIN ── *@
        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="nav-section-title">QUẢN TRỊ HỆ THỐNG</div>

                <NavLink class="nav-card" href="admin/pois">
                    <span class="bi bi-shop"></span><span class="nav-text">Quản lý gian hàng</span>
                </NavLink>
                <NavLink class="nav-card" href="ma-qr">
                    <span class="bi bi-qr-code"></span><span class="nav-text">Quản lý mã QR</span>
                </NavLink>
                <NavLink class="nav-card" href="quan-ly-ngon-ngu">
                    <span class="bi bi-translate"></span><span class="nav-text">Ngôn ngữ &amp; Dịch</span>
                </NavLink>
                <NavLink class="nav-card" href="admin/ban-do">
                    <span class="bi bi-geo-alt"></span><span class="nav-text">Bản đồ POI</span>
                </NavLink>
                <NavLink class="nav-card" href="admin/intro-audio">
                    <span class="bi bi-broadcast"></span><span class="nav-text">Audio Intro Phố</span>
                </NavLink>
                <NavLink class="nav-card" href="nguoi-dung">
                    <span class="bi bi-people"></span><span class="nav-text">Nhân sự &amp; Vendor</span>
                </NavLink>
                <NavLink class="nav-card" href="admin/phan-hoi-app">
                    <span class="bi bi-chat-heart"></span><span class="nav-text">Phản hồi App</span>
                </NavLink>
            </Authorized>
        </AuthorizeView>

        @* ── MENU DÀNH RIÊNG CHO VENDOR (CHỦ QUÁN) ── *@
        <AuthorizeView Roles="Vendor">
            <Authorized>
                <div class="nav-section-title">QUẢN LÝ QUÁN ĂN</div>

                <NavLink class="nav-card" href="vendor/thong-tin">
                    <span class="bi bi-info-square"></span><span class="nav-text">Mô tả &amp; Hình ảnh</span>
                </NavLink>
                <NavLink class="nav-card" href="vendor/thuc-don">
                    <span class="bi bi-card-list"></span><span class="nav-text">Thực đơn (Menu)</span>
                </NavLink>
                <NavLink class="nav-card" href="vendor/goi-thanh-vien">
                    <span class="bi bi-gem"></span><span class="nav-text">Gói thành viên</span>
                </NavLink>
                <NavLink class="nav-card" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-wallet2"></span><span class="nav-text">Dashboard tổng hợp</span>
                </NavLink>
            </Authorized>
        </AuthorizeView>
    </nav>

    @* ── Khu vực user info + Logout ở cuối sidebar ── *@
    <div class="mt-auto pt-4" style="border-top: 1px solid #E2E8F0;">
        <AuthorizeView>
            <Authorized>
                <div class="d-flex align-items-center gap-2 px-2 mb-3">
                    <span class="badge rounded-circle p-2 fs-6"
                          style="background-color: #C8372D; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; color: white;">
                        @context.User.Identity?.Name?.Substring(0, 1).ToUpper()
                    </span>
                    <div>
                        <div style="color: #1E293B; font-size: 13px; font-weight: 500;">
                            @context.User.Identity?.Name
                        </div>
                        <div style="color: #64748B; font-size: 11px;">
                            @context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                        </div>
                    </div>
                </div>
                <a href="/logout" class="nav-card" style="color: #C8372D;">
                    <span class="bi bi-box-arrow-left"></span><span class="nav-text">Đăng xuất</span>
                </a>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

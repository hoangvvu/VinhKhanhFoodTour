    private class LangStat { public string Code = ""; public string Name = ""; public int DeviceCount; }

    /// <summary>
    /// Chuẩn hoá language code lưu trong tracking log:
    /// - bỏ prefix legacy như "anon:vi" → "vi"
    /// - lower-case, trim
    /// - rỗng/null → null
    /// </summary>
    private static string? NormalizeLangCode(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        var v = raw.Trim();
        var colon = v.IndexOf(':');
        if (colon >= 0 && colon < v.Length - 1)
            v = v[(colon + 1)..];
        // Cắt region: "zh-CN" -> "zh", "en-US" -> "en"
        var dash = v.IndexOf('-');
        if (dash > 0) v = v[..dash];
        v = v.Trim().ToLowerInvariant();
        return string.IsNullOrEmpty(v) ? null : v;
    }

    /// <summary>Tên hiển thị fallback khi code không có trong bảng Languages.</summary>
    private static string FallbackLanguageName(string code) => code switch
    {
        "vi" => "Tiếng Việt",
        "en" => "English",
        "ja" => "日本語",
        "ko" => "한국어",
        "zh" => "中文",
        "fr" => "Français",
        "de" => "Deutsch",
        "es" => "Español",
        "ru" => "Русский",
        "th" => "ไทย",
        _ => code.ToUpperInvariant()
    };


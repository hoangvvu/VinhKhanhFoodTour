@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using global::Admin.Services
@using VKFoodTour.Infrastructure.Data
@using VKFoodTour.Infrastructure.Entities
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@rendermode InteractiveServer

@inject AuthenticationStateProvider AuthStateProvider
@inject ApplicationDbContext Db
@inject DashboardMetricsService DashboardMetrics

<PageTitle>Dashboard - Vĩnh Khánh</PageTitle>



<div class="dash-page p-4">

    @if (isLoading)
    {
        <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 60vh;">
            <div class="spinner-border text-danger mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
            <span style="color: #64748B; font-size: 13px; letter-spacing: 1px;">ĐANG TẢI DỮ LIỆU…</span>
        </div>
    }
    else
    {
        @* ══════════════════════════════════════════════════════════
           ADMIN DASHBOARD
           ══════════════════════════════════════════════════════════ *@
        <AuthorizeView Roles="Admin">
            <Authorized>

                @* ── Header ── *@
                <div class="d-flex justify-content-between align-items-center mb-5">
                    <div>
                        <h2 class="fw-bold mb-1" style="color: #1E293B; letter-spacing: -0.5px;">Tổng quan hệ thống</h2>
                        <span style="color: #64748B; font-size: 13px;">
                            <i class="bi bi-clock me-1"></i>Cập nhật lúc @DateTime.Now.ToString("HH:mm, dd/MM/yyyy")
                        </span>
                    </div>
                    <span class="badge px-3 py-2" style="background: rgba(200,55,45,0.1); color: #C8372D; border: 1px solid rgba(200,55,45,0.2); border-radius: 20px; font-size: 12px;">
                        <i class="bi bi-shield-fill me-1"></i>Quản trị viên
                    </span>
                </div>

                @* ── REALTIME ROW ── *@
                <div class="dash-label"><i class="bi bi-wifi me-2"></i>REALTIME — THIẾT BỊ ĐANG DÙNG APP</div>
                <div class="row g-4 mb-5">
                    <div class="col-12">
                        <ActiveDevicesWidget WindowSeconds="45" RefreshSeconds="3" />
                    </div>
                </div>

                @* ── THỐNG KÊ HỆ THỐNG ── *@
                <div class="dash-label"><i class="bi bi-grid-1x2 me-2"></i>THỐNG KÊ HỆ THỐNG</div>
                <div class="row g-3 mb-5">
                    @foreach (var card in adminSystemCards)
                    {
                        <div class="col-6 col-md-3">
                            <div class="dash-card p-4">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div style="background: @card.IconBg; border-radius: 10px; padding: 10px;">
                                        <i class="bi @card.Icon" style="color: @card.IconColor; font-size: 1.3rem;"></i>
                                    </div>
                                    <span class="badge" style="background: @card.BadgeBg; color: @card.BadgeColor; font-size: 10px;">@GetAdminCardBadgeText(card)</span>
                                </div>
                                <h3 class="fw-bold mb-1" style="color: #1E293B;">@GetAdminCardValue(card)</h3>
                                <div style="color: #64748B; font-size: 12px; letter-spacing: 0.5px;">@card.Title</div>
                            </div>
                        </div>
                    }
                </div>

            </Authorized>
        </AuthorizeView>

        @* ══════════════════════════════════════════════════════════
           VENDOR DASHBOARD
           ══════════════════════════════════════════════════════════ *@
        <AuthorizeView Roles="Vendor">
            <Authorized>
                <div class="d-flex justify-content-between align-items-center mb-5">
                    <div>
                        <h2 class="fw-bold mb-1" style="color: #1E293B;">Xin chào, @vendorPoiName!</h2>
                        <span style="color: #64748B; font-size: 13px;">
                            <i class="bi bi-clock me-1"></i>@DateTime.Now.ToString("HH:mm, dd/MM/yyyy")
                        </span>
                    </div>
                    <span class="badge px-3 py-2" style="background: rgba(14,165,233,0.1); color: #0EA5E9; border: 1px solid rgba(14,165,233,0.2); border-radius: 20px; font-size: 12px;">
                        <i class="bi bi-person-badge me-1"></i>Đối tác (Vendor)
                    </span>
                </div>

                <div class="dash-label"><i class="bi bi-grid me-2"></i>TỔNG QUAN QUÁN (GỘP)</div>
                <div class="row g-4 mb-4">
                    @foreach (var card in vendorOverviewCards)
                    {
                        <div class="col-6 col-md-3">
                            <div class="dash-card p-4 h-100" style="border-left: 4px solid @card.AccentColor !important;">
                                <div style="background: @card.IconBg; border-radius: 10px; padding: 10px; width: fit-content; margin-bottom: 12px;">
                                    <i class="bi @card.Icon" style="color: @card.AccentColor; font-size: 1.3rem;"></i>
                                </div>
                                <h3 class="fw-bold mb-1" style="color: #1E293B;">@GetVendorCardValue(card)</h3>
                                <div style="color: #64748B; font-size: 12px; letter-spacing: 0.5px;">@card.Title</div>
                                @if (!string.IsNullOrWhiteSpace(card.Subtitle))
                                {
                                    <div style="color: #94A3B8; font-size: 12px; margin-top: 4px;">@card.Subtitle</div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="dash-label"><i class="bi bi-list-check me-2"></i>CHECKLIST VẬN HÀNH</div>
                <div class="dash-card p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div style="color:#64748B;font-size:12px;">Những việc cần hoàn thiện để quán hoạt động hiệu quả</div>
                        <div style="color:#94A3B8;font-size:11px;">Cập nhật: @vendorLastUpdated.ToString("HH:mm dd/MM")</div>
                    </div>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var item in vendorChecklist)
                        {
                            <a href="@item.Url" class="d-flex align-items-center justify-content-between p-3 rounded-3" style="background:#F8FAFC;border:1px solid #E2E8F0;">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi @(item.Done ? "bi-check-circle-fill text-success" : "bi-exclamation-circle-fill text-warning")"></i>
                                    <span style="color:#1E293B;font-size:14px;">@item.Label</span>
                                </div>
                                <span class="small @(item.Done ? "text-success" : "text-muted")">@(item.Done ? "Đã xong" : "Cần làm")</span>
                            </a>
                        }
                    </div>
                </div>

                <div class="dash-label"><i class="bi bi-lightning-charge me-2"></i>HÀNH ĐỘNG NHANH</div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <a class="dash-card p-4 d-block h-100" href="vendor/thong-tin">
                            <div class="fw-bold mb-2" style="color:#1E293B;"><i class="bi bi-shop me-2 text-danger"></i>Thông tin gian hàng</div>
                            <div style="color:#64748B;font-size:13px;">Sửa mô tả, địa chỉ, hình ảnh và đồng bộ audio đa ngôn ngữ.</div>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a class="dash-card p-4 d-block h-100" href="vendor/thuc-don">
                            <div class="fw-bold mb-2" style="color:#1E293B;"><i class="bi bi-card-list me-2 text-info"></i>Thực đơn</div>
                            <div style="color:#64748B;font-size:13px;">Thêm/sửa/ẩn món ăn để cập nhật hiển thị trên app ngay.</div>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a class="dash-card p-4 d-block h-100" href="vendor/goi-thanh-vien">
                            <div class="fw-bold mb-2" style="color:#1E293B;"><i class="bi bi-gem me-2 text-warning"></i>Gói thành viên</div>
                            <div style="color:#64748B;font-size:13px;">Nâng cấp gói để mở rộng vùng phát audio và tăng độ ưu tiên.</div>
                        </a>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
    }
</div>

@code {
    private bool isLoading = true;

    // Chỉnh nhanh hiển thị dashboard admin tại đây (text/icon/màu/badge/value key).
    private readonly List<AdminStatCardConfig> adminSystemCards =
    [
        new("totalPois", "TỔNG GIAN HÀNG", "bi-shop", "rgba(245,158,11,0.12)", "#F59E0B", "{activePois} hoạt động", "rgba(245,158,11,0.1)", "#F59E0B"),

        new("totalUsers", "NGƯỜI DÙNG", "bi-people-fill", "rgba(200,55,45,0.12)", "#C8372D", "{totalVendors} vendor", "rgba(200,55,45,0.1)", "#C8372D"),
        new("todayQrScans", "LƯỢT QUÉT QR", "bi-qr-code-scan", "rgba(16,185,129,0.12)", "#10B981", "hôm nay", "rgba(16,185,129,0.1)", "#10B981")
    ];



    // ── Admin stats – hệ thống ───────────────
    private int totalPois, activePois;
    private int todayQrScans, totalUsers, totalVendors;

    // ── Vendor stats ─────────────────────────
    private string vendorPoiName = "Chủ quán";
    private int vendorQrScans, vendorReviewCount, vendorMenuCount, vendorAudioPlayCount;
    private double vendorAvgRating;
    private string vendorMembershipTier = "Standard";
    private DateTime vendorLastUpdated = DateTime.Now;
    private List<VendorChecklistItem> vendorChecklist = new();

    private readonly List<VendorOverviewCardConfig> vendorOverviewCards =
    [
        new("vendorQrScans", "LƯỢT QUÉT QR HÔM NAY", "bi-qr-code-scan", "#F59E0B", "rgba(245,158,11,0.12)", "Tại quán của bạn"),
        new("vendorAudioPlayCount", "LƯỢT NGHE AUDIO HÔM NAY", "bi-headphones", "#0EA5E9", "rgba(14,165,233,0.12)", "Nguồn: tracking app"),
        new("vendorAvgRating", "ĐÁNH GIÁ TRUNG BÌNH", "bi-star-fill", "#EAB308", "rgba(234,179,8,0.12)", null),
        new("vendorMembershipTier", "GÓI THÀNH VIÊN", "bi-gem", "#7C3AED", "rgba(124,58,237,0.12)", null)
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var role = user.FindFirst(ClaimTypes.Role)?.Value;

            if (role == "Admin")
                await LoadAdminStats();
            else if (role == "Vendor")
                await LoadVendorStats(user);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[HOME] Load error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadAdminStats()
    {
        var today = DateTime.Today;

        totalPois     = await Db.Pois.CountAsync();
        activePois    = await Db.Pois.CountAsync(p => p.IsActive);
        totalUsers = await Db.Users.CountAsync();
        totalVendors  = await Db.Users.CountAsync(u => u.Role == "Vendor");
        todayQrScans  = await Db.TrackingLogs
            .CountAsync(t => t.EventType == "qr_scan" && t.CreatedAt >= today);
    }

    private async Task LoadVendorStats(ClaimsPrincipal user)
    {
        var userIdStr = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(userIdStr, out int userId)) return;

        var metrics = await DashboardMetrics.GetVendorMetricsAsync(userId);
        if (metrics is null) return;

        vendorPoiName = metrics.PoiName;
        vendorMembershipTier = metrics.MembershipTier;
        vendorQrScans = metrics.QrScanCountToday;
        vendorAudioPlayCount = metrics.AudioPlayCountToday;
        vendorReviewCount = metrics.TotalReviews;
        vendorAvgRating = metrics.AverageRating;
        vendorMenuCount = metrics.MenuCount;
        vendorLastUpdated = metrics.LastUpdated;

        vendorChecklist =
        [
            new("Có mô tả gian hàng", metrics.HasDescription, "vendor/thong-tin"),
            new("Có địa chỉ + vị trí bản đồ", metrics.HasAddress && metrics.HasValidMap, "vendor/thong-tin"),
            new("Có ảnh bìa gian hàng", metrics.HasCover, "vendor/thong-tin"),
            new("Có audio tự động ít nhất 1 ngôn ngữ", metrics.HasAudio, "vendor/thong-tin"),
            new("Có món ăn đang bán", metrics.MenuCount > 0, "vendor/thuc-don")
        ];
    }



    private sealed record AdminStatCardConfig(
        string Key,
        string Title,
        string Icon,
        string IconBg,
        string IconColor,
        string? BadgeTemplate = null,
        string BadgeBg = "transparent",
        string BadgeColor = "#64748B");

    private string GetAdminCardValue(AdminStatCardConfig card) => card.Key switch
    {
        "totalPois" => totalPois.ToString(),
        "totalUsers" => totalUsers.ToString(),
        "todayQrScans" => todayQrScans.ToString(),
        _ => "0"
    };

    private string GetAdminCardBadgeText(AdminStatCardConfig card)
    {
        if (string.IsNullOrWhiteSpace(card.BadgeTemplate))
            return string.Empty;

        return card.BadgeTemplate
            .Replace("{activePois}", activePois.ToString())
            .Replace("{totalVendors}", totalVendors.ToString());
    }

    private sealed record VendorOverviewCardConfig(
        string Key,
        string Title,
        string Icon,
        string AccentColor,
        string IconBg,
        string? Subtitle = null);

    private sealed record VendorChecklistItem(string Label, bool Done, string Url);

    private string GetVendorCardValue(VendorOverviewCardConfig card) => card.Key switch
    {
        "vendorQrScans" => vendorQrScans.ToString(),
        "vendorAudioPlayCount" => vendorAudioPlayCount.ToString(),
        "vendorAvgRating" => vendorAvgRating > 0 ? $"{vendorAvgRating:0.0} ★" : "Chưa có",
        "vendorMembershipTier" => vendorMembershipTier,
        _ => "—"
    };
}

@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using global::Admin.Services
@using VKFoodTour.Infrastructure.Data
@using VKFoodTour.Infrastructure.Entities
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@rendermode InteractiveServer

@inject AuthenticationStateProvider AuthStateProvider
@inject ApplicationDbContext Db
@inject DashboardMetricsService DashboardMetrics

<PageTitle>Dashboard - Vĩnh Khánh</PageTitle>

<style>
    .rank-row { transition: background 0.15s; border-radius: 10px; }
    .rank-row:hover { background: #F1F5F9; }

    .progress-thin { height: 6px; border-radius: 3px; background: #E2E8F0; }

    .pulse-dot { animation: pulse 2s infinite; }
    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }
</style>

<div class="dash-page p-4">

    @if (isLoading)
    {
        <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 60vh;">
            <div class="spinner-border text-danger mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
            <span style="color: #64748B; font-size: 13px; letter-spacing: 1px;">ĐANG TẢI DỮ LIỆU…</span>
        </div>
    }
    else
    {
        @* ══════════════════════════════════════════════════════════
           ADMIN DASHBOARD
           ══════════════════════════════════════════════════════════ *@
        <AuthorizeView Roles="Admin">
            <Authorized>

                @* ── Header ── *@
                <div class="d-flex justify-content-between align-items-center mb-5">
                    <div>
                        <h2 class="fw-bold mb-1" style="color: #1E293B; letter-spacing: -0.5px;">Tổng quan hệ thống</h2>
                        <span style="color: #64748B; font-size: 13px;">
                            <i class="bi bi-clock me-1"></i>Cập nhật lúc @DateTime.Now.ToString("HH:mm, dd/MM/yyyy")
                        </span>
                    </div>
                    <span class="badge px-3 py-2" style="background: rgba(200,55,45,0.1); color: #C8372D; border: 1px solid rgba(200,55,45,0.2); border-radius: 20px; font-size: 12px;">
                        <i class="bi bi-shield-fill me-1"></i>Quản trị viên
                    </span>
                </div>

                @* ── REALTIME ROW ── *@
                <div class="dash-label"><i class="bi bi-wifi me-2"></i>REALTIME — THIẾT BỊ ĐANG DÙNG APP</div>
                <div class="row g-4 mb-5">
                    <div class="col-12">
                        <ActiveDevicesWidget WindowSeconds="45" RefreshSeconds="3" />
                    </div>
                </div>

                @* ── THỐNG KÊ HỆ THỐNG ── *@
                <div class="dash-label"><i class="bi bi-grid-1x2 me-2"></i>THỐNG KÊ HỆ THỐNG</div>
                <div class="row g-3 mb-5">
                    @foreach (var card in adminSystemCards)
                    {
                        <div class="col-6 col-md-3">
                            <div class="dash-card p-4">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div style="background: @card.IconBg; border-radius: 10px; padding: 10px;">
                                        <i class="bi @card.Icon" style="color: @card.IconColor; font-size: 1.3rem;"></i>
                                    </div>
                                    <span class="badge" style="background: @card.BadgeBg; color: @card.BadgeColor; font-size: 10px;">@GetAdminCardBadgeText(card)</span>
                                </div>
                                <h3 class="fw-bold mb-1" style="color: #1E293B;">@GetAdminCardValue(card)</h3>
                                <div style="color: #64748B; font-size: 12px; letter-spacing: 0.5px;">@card.Title</div>
                            </div>
                        </div>
                    }
                </div>

                @* ── THỐNG KÊ HÀNH VI ── *@
                <div class="dash-label"><i class="bi bi-activity me-2"></i>HÀNH VI NGƯỜI DÙNG</div>
                <div class="row g-3 mb-5">
                    @foreach (var card in adminBehaviorCards)
                    {
                        <div class="col-6 col-md-4">
                            <div class="dash-card p-4">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div style="background: @card.IconBg; border-radius: 10px; padding: 10px;">
                                        <i class="bi @card.Icon" style="color: @card.IconColor; font-size: 1.3rem;"></i>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(card.BadgeTemplate))
                                    {
                                        <span class="badge" style="background: @card.BadgeBg; color: @card.BadgeColor; font-size: 10px;">@GetAdminCardBadgeText(card)</span>
                                    }
                                </div>
                                <h3 class="fw-bold mb-1" style="color: #1E293B;">@GetAdminCardValue(card)</h3>
                                <div style="color: #64748B; font-size: 12px; letter-spacing: 0.5px;">@card.Title</div>
                            </div>
                        </div>
                    }
                </div>

                @* ── XẾP HẠNG ── *@
                <div class="dash-label"><i class="bi bi-trophy me-2"></i>XẾP HẠNG NỔI BẬT</div>
                <div class="row g-4 mb-5">
                    @* Top POI *@
                    <div class="col-md-6">
                        <div class="dash-card p-4 h-100">
                            <div class="d-flex align-items-center gap-2 mb-4">
                                <div style="background: rgba(245,158,11,0.12); border-radius: 10px; padding: 8px 10px;">
                                    <i class="bi bi-geo-alt-fill" style="color: #F59E0B;"></i>
                                </div>
                                <span class="fw-bold" style="color: #F59E0B; letter-spacing: 0.5px; font-size: 13px;">TOP GIAN HÀNG ĐƯỢC QUAN TÂM</span>
                            </div>
                            @if (topPois.Any())
                            {
                                @foreach (var (poi, i) in topPois.Select((p, i) => (p, i)))
                                {
                                    <div class="rank-row d-flex justify-content-between align-items-center px-2 py-2 mb-1">
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="fw-bold" style="min-width: 22px; color: @(i == 0 ? "#F59E0B" : i == 1 ? "#94A3B8" : i == 2 ? "#D97706" : "#64748B"); font-size: 14px;">@(i + 1)</span>
                                            <span style="color: #1E293B; font-size: 14px; font-weight: 500;">@poi.PoiName</span>
                                        </div>
                                        <span class="fw-bold" style="color: #F59E0B; font-size: 13px;">@poi.EventCount <span style="color: #64748B; font-weight: 400;">lượt</span></span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-4" style="color: #64748B;">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>Chưa có dữ liệu
                                </div>
                            }
                        </div>
                    </div>

                    @* Top Audio *@
                    <div class="col-md-6">
                        <div class="dash-card p-4 h-100">
                            <div class="d-flex align-items-center gap-2 mb-4">
                                <div style="background: rgba(14,165,233,0.12); border-radius: 10px; padding: 8px 10px;">
                                    <i class="bi bi-headphones" style="color: #0EA5E9;"></i>
                                </div>
                                <span class="fw-bold" style="color: #0EA5E9; letter-spacing: 0.5px; font-size: 13px;">TOP THUYẾT MINH ĐƯỢC NGHE</span>
                            </div>
                            @if (topAudio.Any())
                            {
                                @foreach (var (item, i) in topAudio.Select((a, i) => (a, i)))
                                {
                                    <div class="rank-row d-flex justify-content-between align-items-center px-2 py-2 mb-1">
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="fw-bold" style="min-width: 22px; color: @(i == 0 ? "#0EA5E9" : i == 1 ? "#94A3B8" : i == 2 ? "#D97706" : "#64748B"); font-size: 14px;">@(i + 1)</span>
                                            <span style="color: #1E293B; font-size: 14px; font-weight: 500;">@item.PoiName</span>
                                        </div>
                                        <span class="fw-bold" style="color: #0EA5E9; font-size: 13px;">@item.TotalMinutes <span style="color: #64748B; font-weight: 400;">phút</span></span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-4" style="color: #64748B;">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>Chưa có dữ liệu
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* ── PHÂN TÍCH ── *@
                <div class="dash-label"><i class="bi bi-bar-chart-line me-2"></i>PHÂN TÍCH</div>
                <div class="row g-4">
                    @* Ngôn ngữ *@
                    <div class="col-md-6">
                        <div class="dash-card p-4 h-100">
                            <div class="d-flex align-items-center gap-2 mb-4">
                                <div style="background: rgba(14,165,233,0.12); border-radius: 10px; padding: 8px 10px;">
                                    <i class="bi bi-translate" style="color: #0EA5E9;"></i>
                                </div>
                                <span class="fw-bold" style="color: #1E293B; letter-spacing: 0.5px; font-size: 13px;">NGÔN NGỮ SỬ DỤNG</span>
                            </div>
                            @if (languageStats.Any())
                            {
                                var maxDevices = languageStats.Max(l => l.DeviceCount);
                                @foreach (var lang in languageStats)
                                {
                                    var barWidth = maxDevices > 0 ? (int)(lang.DeviceCount * 100.0 / maxDevices) : 0;
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span style="color: #1E293B; font-size: 13px; font-weight: 500;">@lang.Name <span style="color: #64748B; font-weight: normal;">(@lang.Code.ToUpper())</span></span>
                                            <span class="fw-bold" style="color: #0EA5E9; font-size: 13px;">@lang.DeviceCount <span style="color:#64748B;font-weight:400;">thiết bị</span></span>
                                        </div>
                                        <div class="progress-thin">
                                            <div class="progress-bar" style="background: linear-gradient(90deg, #0EA5E9, #0284c7); width: @barWidth%; height: 100%; border-radius: 3px;"></div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-4" style="color: #64748B;">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>Chưa có dữ liệu
                                </div>
                            }
                        </div>
                    </div>

                    @* Phân bổ đánh giá *@
                    <div class="col-md-6">
                        <div class="dash-card p-4 h-100">
                            <div class="d-flex align-items-center gap-2 mb-4">
                                <div style="background: rgba(234,179,8,0.12); border-radius: 10px; padding: 8px 10px;">
                                    <i class="bi bi-star-fill" style="color: #EAB308;"></i>
                                </div>
                                <span class="fw-bold" style="color: #1E293B; letter-spacing: 0.5px; font-size: 13px;">PHÂN BỔ ĐÁNH GIÁ</span>
                            </div>
                            @for (int star = 5; star >= 1; star--)
                            {
                                var count = ratingDistribution.GetValueOrDefault(star, 0);
                                var percent = totalReviews > 0 ? (count * 100 / totalReviews) : 0;
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="d-flex align-items-center gap-1" style="min-width: 50px;">
                                        <span style="color: #EAB308; font-size: 13px; font-weight: 600;">@star</span>
                                        <i class="bi bi-star-fill" style="color: #EAB308; font-size: 10px;"></i>
                                    </div>
                                    <div class="flex-grow-1 progress-thin">
                                        <div style="background: linear-gradient(90deg, #EAB308, #D97706); width: @percent%; height: 100%; border-radius: 3px;"></div>
                                    </div>
                                    <span style="color: #64748B; font-size: 12px; min-width: 30px; text-align: right;">@count</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </Authorized>
        </AuthorizeView>

        @* ══════════════════════════════════════════════════════════
           VENDOR DASHBOARD
           ══════════════════════════════════════════════════════════ *@
        <AuthorizeView Roles="Vendor">
            <Authorized>
                <div class="d-flex justify-content-between align-items-center mb-5">
                    <div>
                        <h2 class="fw-bold mb-1" style="color: #1E293B;">Xin chào, @vendorPoiName!</h2>
                        <span style="color: #64748B; font-size: 13px;">
                            <i class="bi bi-clock me-1"></i>@DateTime.Now.ToString("HH:mm, dd/MM/yyyy")
                        </span>
                    </div>
                    <span class="badge px-3 py-2" style="background: rgba(14,165,233,0.1); color: #0EA5E9; border: 1px solid rgba(14,165,233,0.2); border-radius: 20px; font-size: 12px;">
                        <i class="bi bi-person-badge me-1"></i>Đối tác (Vendor)
                    </span>
                </div>

                <div class="dash-label"><i class="bi bi-grid me-2"></i>TỔNG QUAN QUÁN (GỘP)</div>
                <div class="row g-4 mb-4">
                    @foreach (var card in vendorOverviewCards)
                    {
                        <div class="col-6 col-md-3">
                            <div class="dash-card p-4 h-100" style="border-left: 4px solid @card.AccentColor !important;">
                                <div style="background: @card.IconBg; border-radius: 10px; padding: 10px; width: fit-content; margin-bottom: 12px;">
                                    <i class="bi @card.Icon" style="color: @card.AccentColor; font-size: 1.3rem;"></i>
                                </div>
                                <h3 class="fw-bold mb-1" style="color: #1E293B;">@GetVendorCardValue(card)</h3>
                                <div style="color: #64748B; font-size: 12px; letter-spacing: 0.5px;">@card.Title</div>
                                @if (!string.IsNullOrWhiteSpace(card.Subtitle))
                                {
                                    <div style="color: #94A3B8; font-size: 12px; margin-top: 4px;">@card.Subtitle</div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="dash-label"><i class="bi bi-list-check me-2"></i>CHECKLIST VẬN HÀNH</div>
                <div class="dash-card p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div style="color:#64748B;font-size:12px;">Những việc cần hoàn thiện để quán hoạt động hiệu quả</div>
                        <div style="color:#94A3B8;font-size:11px;">Cập nhật: @vendorLastUpdated.ToString("HH:mm dd/MM")</div>
                    </div>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var item in vendorChecklist)
                        {
                            <a href="@item.Url" class="d-flex align-items-center justify-content-between p-3 rounded-3" style="background:#F8FAFC;border:1px solid #E2E8F0;">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi @(item.Done ? "bi-check-circle-fill text-success" : "bi-exclamation-circle-fill text-warning")"></i>
                                    <span style="color:#1E293B;font-size:14px;">@item.Label</span>
                                </div>
                                <span class="small @(item.Done ? "text-success" : "text-muted")">@(item.Done ? "Đã xong" : "Cần làm")</span>
                            </a>
                        }
                    </div>
                </div>

                <div class="dash-label"><i class="bi bi-lightning-charge me-2"></i>HÀNH ĐỘNG NHANH</div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <a class="dash-card p-4 d-block h-100" href="vendor/thong-tin">
                            <div class="fw-bold mb-2" style="color:#1E293B;"><i class="bi bi-shop me-2 text-danger"></i>Thông tin gian hàng</div>
                            <div style="color:#64748B;font-size:13px;">Sửa mô tả, địa chỉ, hình ảnh và đồng bộ audio đa ngôn ngữ.</div>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a class="dash-card p-4 d-block h-100" href="vendor/thuc-don">
                            <div class="fw-bold mb-2" style="color:#1E293B;"><i class="bi bi-card-list me-2 text-info"></i>Thực đơn</div>
                            <div style="color:#64748B;font-size:13px;">Thêm/sửa/ẩn món ăn để cập nhật hiển thị trên app ngay.</div>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a class="dash-card p-4 d-block h-100" href="vendor/goi-thanh-vien">
                            <div class="fw-bold mb-2" style="color:#1E293B;"><i class="bi bi-gem me-2 text-warning"></i>Gói thành viên</div>
                            <div style="color:#64748B;font-size:13px;">Nâng cấp gói để mở rộng vùng phát audio và tăng độ ưu tiên.</div>
                        </a>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
    }
</div>

@code {
    private bool isLoading = true;

    // Chỉnh nhanh hiển thị dashboard admin tại đây (text/icon/màu/badge/value key).
    private readonly List<AdminStatCardConfig> adminSystemCards =
    [
        new("totalPois", "TỔNG GIAN HÀNG", "bi-shop", "rgba(245,158,11,0.12)", "#F59E0B", "{activePois} hoạt động", "rgba(245,158,11,0.1)", "#F59E0B"),
        new("totalLanguages", "NGÔN NGỮ", "bi-translate", "rgba(14,165,233,0.12)", "#0EA5E9", null, "rgba(14,165,233,0.1)", "#0EA5E9"),
        new("totalUsers", "NGƯỜI DÙNG", "bi-people-fill", "rgba(200,55,45,0.12)", "#C8372D", "{totalVendors} vendor", "rgba(200,55,45,0.1)", "#C8372D"),
        new("todayQrScans", "LƯỢT QUÉT QR", "bi-qr-code-scan", "rgba(16,185,129,0.12)", "#10B981", "hôm nay", "rgba(16,185,129,0.1)", "#10B981")
    ];

    private readonly List<AdminStatCardConfig> adminBehaviorCards =
    [
        new("totalEvents", "LƯỢT TƯƠNG TÁC HÔM NAY", "bi-cursor-fill", "rgba(245,158,11,0.12)", "#F59E0B", "hôm nay", "rgba(245,158,11,0.1)", "#F59E0B"),
        new("avgListenSec", "THỜI GIAN NGHE TB", "bi-headphones", "rgba(14,165,233,0.12)", "#0EA5E9", "giây/lần", "rgba(14,165,233,0.1)", "#0EA5E9"),
        new("totalReviews", "TỔNG ĐÁNH GIÁ", "bi-star-fill", "rgba(234,179,8,0.12)", "#EAB308")
    ];

    // ── Admin stats – hệ thống ───────────────
    private int totalPois, activePois, totalNarrations, totalLanguages;
    private int todayQrScans, totalUsers, totalVendors;
    private List<TopPoiItem> topPois = new();
    private List<TopAudioItem> topAudio = new();

    // ── Admin stats – hành vi ────────────────
    private int totalEvents, avgListenSec, totalReviews;
    private List<LangStat> languageStats = new();
    private Dictionary<int, int> ratingDistribution = new();

    // ── Vendor stats ─────────────────────────
    private string vendorPoiName = "Chủ quán";
    private int vendorQrScans, vendorReviewCount, vendorMenuCount, vendorAudioPlayCount;
    private double vendorAvgRating;
    private string vendorMembershipTier = "Standard";
    private DateTime vendorLastUpdated = DateTime.Now;
    private List<VendorChecklistItem> vendorChecklist = new();

    private readonly List<VendorOverviewCardConfig> vendorOverviewCards =
    [
        new("vendorQrScans", "LƯỢT QUÉT QR HÔM NAY", "bi-qr-code-scan", "#F59E0B", "rgba(245,158,11,0.12)", "Tại quán của bạn"),
        new("vendorAudioPlayCount", "LƯỢT NGHE AUDIO HÔM NAY", "bi-headphones", "#0EA5E9", "rgba(14,165,233,0.12)", "Nguồn: tracking app"),
        new("vendorAvgRating", "ĐÁNH GIÁ TRUNG BÌNH", "bi-star-fill", "#EAB308", "rgba(234,179,8,0.12)", null),
        new("vendorMembershipTier", "GÓI THÀNH VIÊN", "bi-gem", "#7C3AED", "rgba(124,58,237,0.12)", null)
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var role = user.FindFirst(ClaimTypes.Role)?.Value;

            if (role == "Admin")
                await LoadAdminStats();
            else if (role == "Vendor")
                await LoadVendorStats(user);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[HOME] Load error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadAdminStats()
    {
        var today = DateTime.Today;

        totalPois     = await Db.Pois.CountAsync();
        activePois    = await Db.Pois.CountAsync(p => p.IsActive);
        totalNarrations = await Db.Narrations.CountAsync();
        totalLanguages  = await Db.Languages.CountAsync(l => l.IsActive);
        totalUsers = await Db.Users.CountAsync();
        totalVendors  = await Db.Users.CountAsync(u => u.Role == "Vendor");
        todayQrScans  = await Db.TrackingLogs
            .CountAsync(t => t.EventType == "qr_scan" && t.CreatedAt >= today);

        // Chỉ tính tương tác nghiệp vụ trong ngày, bỏ heartbeat "move" để tránh số liệu bị phình.
        totalEvents = await Db.TrackingLogs
            .CountAsync(t => t.CreatedAt >= today && t.EventType != "move");

        var listenLogs = Db.TrackingLogs.Where(t => t.EventType == "listen_end" && t.ListenedDurationSec != null);
        if (await listenLogs.AnyAsync())
            avgListenSec = (int)await listenLogs.AverageAsync(t => t.ListenedDurationSec!.Value);

        // Top POIs
        topPois = await Db.TrackingLogs
            .Where(t => t.PoiId != null && (t.EventType == "enter" || t.EventType == "qr_scan"))
            .GroupBy(t => t.PoiId)
            .Select(g => new TopPoiItem { PoiId = g.Key!.Value, EventCount = g.Count() })
            .OrderByDescending(x => x.EventCount)
            .Take(5)
            .ToListAsync();

        var poiIds = topPois.Select(x => x.PoiId).ToList();
        var poiNames = await Db.Pois
            .Where(p => poiIds.Contains(p.PoiId))
            .ToDictionaryAsync(p => p.PoiId, p => p.Name);

        foreach (var item in topPois)
            item.PoiName = poiNames.GetValueOrDefault(item.PoiId, "N/A");

        // Top Audio
        topAudio = await Db.TrackingLogs
            .Where(t => t.PoiId != null && t.EventType == "listen_end" && t.ListenedDurationSec != null)
            .GroupBy(t => t.PoiId)
            .Select(g => new TopAudioItem
            {
                PoiId = g.Key!.Value,
                TotalMinutes = (int)(g.Sum(t => t.ListenedDurationSec!.Value) / 60.0)
            })
            .OrderByDescending(x => x.TotalMinutes)
            .Take(5)
            .ToListAsync();

        foreach (var item in topAudio)
            item.PoiName = poiNames.GetValueOrDefault(item.PoiId, "N/A");

        // Ngôn ngữ — đếm số THIẾT BỊ duy nhất theo NGÔN NGỮ MỚI NHẤT của thiết bị đó,
        // trong cửa sổ 30 ngày gần nhất. Cách này phản ánh đúng số người dùng đang
        // dùng từng ngôn ngữ:
        //   * không đếm trùng theo số event (heartbeat 'move' rất nhiều).
        //   * không đếm trùng khi 1 thiết bị từng đổi ngôn ngữ nhiều lần
        //     (chỉ tính ngôn ngữ hiện tại của họ).
        //   * không bị nhiễu bởi log cũ "anon:vi" / null trước khi fix.
        var langWindow = DateTime.Now.AddDays(-30);
        var perDeviceLatest = await Db.TrackingLogs
            .AsNoTracking()
            .Where(t => t.LanguageCode != null && t.DeviceId != null && t.CreatedAt >= langWindow)
            .GroupBy(t => t.DeviceId!)
            .Select(g => new
            {
                DeviceId = g.Key,
                LanguageCode = g.OrderByDescending(x => x.CreatedAt).First().LanguageCode
            })
            .ToListAsync();

        var langNames = await Db.Languages
            .AsNoTracking()
            .ToDictionaryAsync(l => l.Code.ToLower(), l => l.Name);

        var langDeviceCounts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        foreach (var row in perDeviceLatest)
        {
            var code = NormalizeLangCode(row.LanguageCode);
            if (code is null) continue;
            langDeviceCounts[code] = langDeviceCounts.GetValueOrDefault(code, 0) + 1;
        }

        languageStats = langDeviceCounts
            .Select(kvp => new LangStat
            {
                Code = kvp.Key,
                Name = langNames.GetValueOrDefault(kvp.Key, FallbackLanguageName(kvp.Key)),
                DeviceCount = kvp.Value
            })
            .OrderByDescending(l => l.DeviceCount)
            .ToList();

        // Reviews
        totalReviews = await Db.Reviews.CountAsync();
        ratingDistribution = await Db.Reviews
            .GroupBy(r => (int)r.Rating)
            .ToDictionaryAsync(g => g.Key, g => g.Count());
    }

    private async Task LoadVendorStats(ClaimsPrincipal user)
    {
        var userIdStr = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(userIdStr, out int userId)) return;

        var metrics = await DashboardMetrics.GetVendorMetricsAsync(userId);
        if (metrics is null) return;

        vendorPoiName = metrics.PoiName;
        vendorMembershipTier = metrics.MembershipTier;
        vendorQrScans = metrics.QrScanCountToday;
        vendorAudioPlayCount = metrics.AudioPlayCountToday;
        vendorReviewCount = metrics.TotalReviews;
        vendorAvgRating = metrics.AverageRating;
        vendorMenuCount = metrics.MenuCount;
        vendorLastUpdated = metrics.LastUpdated;

        vendorChecklist =
        [
            new("Có mô tả gian hàng", metrics.HasDescription, "vendor/thong-tin"),
            new("Có địa chỉ + vị trí bản đồ", metrics.HasAddress && metrics.HasValidMap, "vendor/thong-tin"),
            new("Có ảnh bìa gian hàng", metrics.HasCover, "vendor/thong-tin"),
            new("Có audio tự động ít nhất 1 ngôn ngữ", metrics.HasAudio, "vendor/thong-tin"),
            new("Có món ăn đang bán", metrics.MenuCount > 0, "vendor/thuc-don")
        ];
    }


@page "/gian-hang"
@using Microsoft.AspNetCore.Authorization
@using VKFoodTour.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@inject ApplicationDbContext Db
@using global::Admin.Services
@inject PoiService PoiService

<div class="dash-page p-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-bold mb-1" style="color: #1E293B;">QUẢN LÝ GIAN HÀNG</h2>
            <span style="color: #64748B; font-size: 13px;"><i class="bi bi-shop me-1"></i>Toàn bộ gian hàng trên phố Vĩnh Khánh</span>
        </div>
        <a href="/admin/pois" class="btn btn-danger rounded-pill px-4 shadow">
            <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa / ẩn gian hàng
        </a>
    </div>

    @if (!string.IsNullOrEmpty(pageMessage))
    {
        <div class="alert @(pageMessageIsError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            @pageMessage
            <button type="button" class="btn-close" @onclick="() => pageMessage = null"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" style="width:2.5rem;height:2.5rem;" role="status"></div>
            <p style="color:#64748B;font-size:13px;letter-spacing:1px;margin-top:12px;">ĐANG TẢI...</p>
        </div>
    }
    else
    {
        <div class="dash-card" style="overflow:hidden;">
            <div class="table-responsive">
                <table class="table dash-table mb-0">
                        <thead class="bg-light text-muted small">
                            <tr>
                                <th class="ps-4 py-3">GIAN HÀNG</th>
                                <th>CHỦ &amp; GMAIL</th>
                                <th>ẢNH</th>
                                <th>ĐỊA CHỈ</th>
                                <th>GEOFENCE</th>
                                <th>NGÔN NGỮ TM</th>
                                <th>MÓN ĂN</th>
                                <th class="text-end pe-4">HÀNH ĐỘNG</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in rows)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="fw-bold">@row.PoiName</span><br />
                                        <span class="badge @(row.Priority >= 4 ? "bg-danger-subtle text-danger" : "bg-secondary") small mt-2">
                                            Ưu tiên @row.Priority
                                        </span>
                                    </td>
                                    <td class="small">
                                        <div class="text-dark">@row.OwnerName</div>
                                        <div class="text-muted">@row.OwnerEmail</div>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1 flex-wrap" style="max-width: 140px;">
                                            @if (!string.IsNullOrEmpty(row.CoverUrl))
                                            {
                                                <img src="@row.CoverUrl" class="rounded border border-secondary" style="width:44px;height:44px;object-fit:cover;" alt="" />
                                            }
                                            @foreach (var u in row.GalleryUrls)
                                            {
                                                <img src="@u" class="rounded border border-secondary" style="width:44px;height:44px;object-fit:cover;" alt="" />
                                            }
                                        </div>
                                    </td>
                                    <td>@(string.IsNullOrEmpty(row.Address) ? "—" : row.Address)</td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info" title="Bán kính mặc định + bonus theo gói thành viên">
                                            @row.EffectiveRadius m
                                        </span>
                                        <div class="text-muted" style="font-size:11px;margin-top:2px;">
                                            @DefaultRadius m + @row.TierBonus m (@row.MembershipTier) + @GpsBuffer m GPS
                                        </div>
                                    </td>
                                    <td>
                                        @foreach (var langCode in row.LangCodes)
                                        {
                                            <span class="badge-lang @(langCode is "vi" or "en" ? "badge-vi" : "badge-other")">
                                                @langCode.ToUpper()
                                            </span>
                                        }
                                        @if (!row.LangCodes.Any())
                                        {
                                            <span class="text-muted small">Chưa có</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info">@row.FoodCount món</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end align-items-center gap-2">
                                            @if (row.IsActive)
                                            {
                                                <span class="badge bg-success">Hoạt động</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Đã ẩn / tắt</span>
                                            }
                                            <button class="btn btn-sm btn-outline-warning rounded-pill"
                                                    disabled="@row.IsSaving"
                                                    @onclick="() => OpenQuickEdit(row)">
                                                <i class="bi bi-pencil-square me-1"></i>Sửa
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger rounded-pill"
                                                    disabled="@row.IsSaving"
                                                    @onclick="() => OpenDeleteConfirm(row)">
                                                <i class="bi bi-trash me-1"></i>Xóa
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }

                            @if (!rows.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-4">Chưa có gian hàng nào.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
            </div>
        </div>
    }
</div>

@if (editRow is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.4); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0" style="background:#FFFFFF;border-radius:18px;border:1px solid #E2E8F0;">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-dark">Sửa ưu tiên hiển thị</h5>
                    <button type="button" class="btn-close" @onclick="CloseQuickEdit"></button>
                </div>
                <div class="modal-body">
                    <div class="text-muted small mb-3">@editRow.PoiName</div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">MỨC ƯU TIÊN</label>
                        <input type="number" min="1" max="5" class="form-control"
                               style="background:#F8FAFC;color:#1E293B;border-color:#E2E8F0;"
                               @bind="editPriority" />
                    </div>
                    <div class="alert alert-info small mb-0" style="background:#F0F9FF;border:1px solid #BAE6FD;color:#075985;">
                        <i class="bi bi-info-circle me-1"></i>
                        Bán kính geofence dùng giá trị mặc định <strong>@DefaultRadius m</strong>,
                        được cộng thêm theo gói thành viên (Standard +0, Silver +5, Gold +10, Diamond +15)
                        và <strong>+@GpsBuffer m GPS buffer</strong> để bù sai số định vị.
                        Hiện tại: <strong>@editRow.EffectiveRadius m</strong> (@editRow.MembershipTier).
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button class="btn btn-outline-secondary rounded-pill" @onclick="CloseQuickEdit">Hủy</button>
                    <button class="btn btn-warning rounded-pill" disabled="@isSavingQuickEdit" @onclick="SaveQuickEditAsync">
                        @if (isSavingQuickEdit)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <span>Lưu</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (deleteRow is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.4); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0" style="background:#FFFFFF;border-radius:18px;border:1px solid #FECACA;">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Xóa gian hàng</h5>
                    <button type="button" class="btn-close" @onclick="CloseDeleteConfirm"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Bạn có chắc chắn muốn xóa gian hàng <strong>@deleteRow.PoiName</strong>?</p>
                    <div class="alert alert-danger small mb-0" style="background:#FEF2F2;border:1px solid #FECACA;color:#991B1B;">
                        <i class="bi bi-info-circle me-1"></i>
                        Hành động này sẽ xóa <strong>vĩnh viễn</strong> gian hàng cùng toàn bộ dữ liệu liên quan:
                        thuyết minh đa ngôn ngữ, mã QR, ảnh bìa &amp; thư viện, món ăn (kèm bản dịch và ảnh),
                        đánh giá và lịch sử theo dõi của khách. Không thể khôi phục.
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button class="btn btn-outline-secondary rounded-pill" @onclick="CloseDeleteConfirm" disabled="@isDeleting">Hủy</button>
                    <button class="btn btn-danger rounded-pill" disabled="@isDeleting" @onclick="ConfirmDeleteAsync">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Đang xóa...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-trash me-1"></i>Xóa vĩnh viễn</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const int DefaultRadius = 20;
    private const int GpsBuffer = 10;

    private List<GianHangRow> rows = new();
    private bool isLoading = true;
    private GianHangRow? editRow;
    private int editPriority;
    private bool isSavingQuickEdit;
    private GianHangRow? deleteRow;
    private bool isDeleting;
    private string? pageMessage;
    private bool pageMessageIsError;

    private static int TierBonusMeters(string? tier) => (tier ?? "Standard") switch
    {
        "Diamond" => 15,
        "Gold" => 10,
        "Silver" => 5,
        _ => 0
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var pois = await Db.Pois
                .AsNoTracking()
                .Where(p => p.Status == "Approved")
                .OrderByDescending(p => p.Priority)
                .ThenBy(p => p.Name)
                .ToListAsync();

            var ownerIds = pois.Where(p => p.OwnerId != null).Select(p => p.OwnerId!.Value).Distinct().ToList();
            var users = await Db.Users.AsNoTracking()
                .Where(u => ownerIds.Contains(u.UserId))
                .ToDictionaryAsync(u => u.UserId, u => u);

            var narrations = await Db.Narrations
                .Include(n => n.Language)
                .Where(n => n.IsActive)
                .AsNoTracking()
                .Select(n => new { n.PoiId, n.Language!.Code })
                .ToListAsync();

            var langsByPoi = narrations
                .GroupBy(n => n.PoiId)
                .ToDictionary(g => g.Key, g => g.Select(x => x.Code).Distinct().ToList());

            var foodCounts = await Db.Foods
                .Where(f => f.IsAvailable)
                .GroupBy(f => f.PoiId)
                .ToDictionaryAsync(g => g.Key, g => g.Count());

            var images = await Db.Images
                .AsNoTracking()
                .Where(i => i.PoiId != null && i.FoodId == null && !i.IsCover)
                .GroupBy(i => i.PoiId!.Value)
                .ToDictionaryAsync(g => g.Key, g => g.OrderBy(i => i.SortOrder).Select(i => i.ImageUrl).Take(3).ToList());

            rows = pois.Select(p =>
            {
                users.TryGetValue(p.OwnerId ?? 0, out var u);
                langsByPoi.TryGetValue(p.PoiId, out var lc);
                images.TryGetValue(p.PoiId, out var gal);
                var tier = u?.MembershipTier ?? "Standard";
                var bonus = TierBonusMeters(tier);
                return new GianHangRow
                {
                    PoiId = p.PoiId,
                    PoiName = p.Name,
                    Priority = p.Priority,
                    Address = p.Address,
                    IsActive = p.IsActive,
                    OwnerName = u?.Name ?? "—",
                    OwnerEmail = u?.Email ?? "—",
                    CoverUrl = p.ImageUrl ?? "",
                    GalleryUrls = gal ?? new List<string>(),
                    LangCodes = lc ?? new List<string>(),
                    FoodCount = foodCounts.GetValueOrDefault(p.PoiId, 0),
                    MembershipTier = tier,
                    TierBonus = bonus,
                    EffectiveRadius = DefaultRadius + bonus + GpsBuffer
                };
            }).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[GIANHANG] {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenQuickEdit(GianHangRow row)
    {
        editRow = row;
        editPriority = row.Priority;
    }

    private void CloseQuickEdit()
    {
        editRow = null;
    }

    private async Task SaveQuickEditAsync()
    {
        if (editRow is null) return;
        var currentRow = editRow;
        var priority = Math.Clamp(editPriority, 1, 5);
        isSavingQuickEdit = true;
        currentRow.IsSaving = true;
        try
        {
            var poi = await Db.Pois.FirstOrDefaultAsync(p => p.PoiId == currentRow.PoiId);
            if (poi is null) return;
            poi.Priority = priority;
            // Bán kính luôn dùng giá trị mặc định, runtime sẽ cộng thêm theo gói thành viên.
            poi.Radius = DefaultRadius;
            poi.UpdatedAt = DateTime.Now;
            await Db.SaveChangesAsync();
            currentRow.Priority = priority;
            CloseQuickEdit();
        }
        finally
        {
            isSavingQuickEdit = false;
            currentRow.IsSaving = false;
        }
    }

    private void OpenDeleteConfirm(GianHangRow row)
    {
        deleteRow = row;
    }

    private void CloseDeleteConfirm()
    {
        if (isDeleting) return;
        deleteRow = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (deleteRow is null) return;
        var target = deleteRow;
        isDeleting = true;
        target.IsSaving = true;
        try
        {
            var (ok, err) = await PoiService.DeletePoiCascadeAsync(target.PoiId);
            if (ok)
            {
                rows.Remove(target);
                pageMessage = $"Đã xóa gian hàng \"{target.PoiName}\" cùng toàn bộ dữ liệu liên quan.";
                pageMessageIsError = false;
                deleteRow = null;
            }
            else
            {
                pageMessage = $"Không thể xóa gian hàng: {err}";
                pageMessageIsError = true;
            }
        }
        catch (Exception ex)
        {
            pageMessage = $"Lỗi khi xóa: {ex.Message}";
            pageMessageIsError = true;
        }
        finally
        {
            isDeleting = false;
            target.IsSaving = false;
        }
    }

    private sealed class GianHangRow
    {
        public int PoiId { get; set; }
        public string PoiName { get; set; } = "";
        public int Priority { get; set; }
        public string? Address { get; set; }
        public bool IsActive { get; set; }
        public bool IsSaving { get; set; }
        public string OwnerName { get; set; } = "";
        public string OwnerEmail { get; set; } = "";
        public string CoverUrl { get; set; } = "";
        public List<string> GalleryUrls { get; set; } = new();
        public List<string> LangCodes { get; set; } = new();
        public int FoodCount { get; set; }
        public string MembershipTier { get; set; } = "Standard";
        public int TierBonus { get; set; }
        public int EffectiveRadius { get; set; }
    }
}

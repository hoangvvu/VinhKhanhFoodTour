@page "/admin/pois"
@using Microsoft.AspNetCore.Authorization
@using VKFoodTour.Infrastructure.Entities
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject PoiService PoiService
@inject IJSRuntime JS
@inject AuthService AuthService
@inject ApplicationDbContext Db

<div class="p-4" style="background:#F4F6FA; min-height:100vh;">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-bold mb-1" style="color: #1E293B;">Gian hàng</h2>
            <span style="color: #64748B; font-size: 13px;"><i class="bi bi-shop me-1"></i>Quản lý danh sách đối tác</span>
        </div>
    </div>

    <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius:16px;">
        <div class="d-flex gap-3">
            <input type="text" class="form-control rounded-pill ps-4 w-50"
                   style="background:#F8FAFC; border:1px solid #E2E8F0; color:#1E293B;"
                   placeholder="Tìm tên quán..."
                   @bind="searchText"
                   @bind:event="oninput" />

            <select class="form-select rounded-pill w-25" style="background:#F8FAFC; border:1px solid #E2E8F0; color:#1E293B;" @bind="filterStatus">
                <option value="all">Tất cả trạng thái</option>
                <option value="active">Đang hoạt động</option>
                <option value="inactive">Đang bị khóa</option>
            </select>

            <select class="form-select rounded-pill w-25" style="background:#F8FAFC; border:1px solid #E2E8F0; color:#1E293B;" @bind="filterApproval">
                <option value="all">Tất cả (Phê duyệt)</option>
                <option value="Pending">Chờ duyệt</option>
                <option value="Approved">Đã duyệt</option>
                <option value="Rejected">Từ chối</option>
            </select>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" style="width:2.5rem;height:2.5rem;" role="status"></div>
            <p style="color:#64748B;font-size:13px;letter-spacing:1px;margin-top:12px;">ĐANG TẢI...</p>
        </div>
    }
    else if (!FilteredPois.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center" style="border-radius:16px;">
            <p style="color:#64748B;" class="fs-5">Không tìm thấy gian hàng nào.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm" style="border-radius:16px; overflow:hidden;">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr style="background:#F1F5F9;">
                            <th class="ps-4" style="color:#64748B;font-size:11px;letter-spacing:1.5px;font-weight:700;border:none;">GIAN HÀNG</th>
                            <th style="color:#64748B;font-size:11px;letter-spacing:1.5px;font-weight:700;border:none;">CHỦ & GMAIL</th>
                            <th style="color:#64748B;font-size:11px;letter-spacing:1.5px;font-weight:700;border:none;">TRẠNG THÁI</th>
                            <th style="color:#64748B;font-size:11px;letter-spacing:1.5px;font-weight:700;border:none;">GÓI THÀNH VIÊN</th>
                            <th style="color:#64748B;font-size:11px;letter-spacing:1.5px;font-weight:700;border:none;">GEOFENCE</th>
                            <th class="text-end pe-4" style="color:#64748B;font-size:11px;letter-spacing:1.5px;font-weight:700;border:none;">HÀNH ĐỘNG</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredPois)
                        {
                            <tr style="border-bottom:1px solid #F1F5F9;">
                                <td class="ps-4" style="vertical-align:middle;">
                                    <strong style="color:#1E293B;">@item.Name</strong><br />
                                    <small style="color:#64748B;">@item.Phone</small>
                                </td>
                                <td style="vertical-align:middle;">
                                    <small style="color:#64748B;">@GetOwnerLabel(item.OwnerId)</small>
                                </td>
                                <td style="vertical-align:middle;">
                                    <div class="mb-1">
                                        @if (item.Status == "Pending")
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle" style="font-size: 10px;">CHỜ DUYỆT</span>
                                        }
                                        else if (item.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size: 10px;">TỪ CHỐI</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 10px;">ĐÃ DUYỆT</span>
                                        }
                                    </div>
                                    @if (item.IsActive)
                                    {
                                        <span class="text-success small" style="font-size: 11px;"><i class="bi bi-circle-fill me-1" style="font-size:7px;"></i> Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger small" style="font-size: 11px;"><i class="bi bi-circle-fill me-1" style="font-size:7px;"></i> ĐÃ KHÓA</span>
                                    }
                                </td>
                                <td style="vertical-align:middle;">
                                    @{ var tier = GetOwnerTier(item.OwnerId); }
                                    <span class="badge rounded-pill px-3 py-2" style="@GetTierBadgeStyle(tier)">
                                        @GetTierEmoji(tier) @GetTierLabel(tier)
                                    </span>
                                </td>
                                <td style="vertical-align:middle;">
                                    @{
                                        var ownerTier = GetOwnerTier(item.OwnerId);
                                        var bonus = GetTierBonus(ownerTier);
                                        var effective = DefaultRadius + bonus;
                                    }
                                    <span class="badge bg-info-subtle text-info border border-info-subtle"
                                          title="@DefaultRadius m mặc định + @bonus m theo gói @ownerTier">
                                        @effective m
                                    </span>
                                </td>
                                <td class="text-end pe-4" style="vertical-align:middle;">
                                    <div class="d-flex justify-content-end gap-2">
                                        @if (item.Status != "Approved")
                                        {
                                            <button class="btn btn-sm btn-success rounded-pill px-3" @onclick="() => ShowApproveModal(item)">Duyệt</button>
                                        }
                                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Sửa thông tin" @onclick="() => ShowEditModal(item)">
                                            <i class="bi bi-pencil me-1"></i>Sửa
                                        </button>
                                        
                                        @if (item.IsActive)
                                        {
                                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="() => ShowHideConfirm(item)">
                                                <i class="bi bi-lock-fill me-1"></i>Khóa
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-success rounded-pill px-3" @onclick="() => ToggleActive(item.PoiId)">
                                                <i class="bi bi-unlock-fill me-1"></i>Mở
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@* Modal Admin Duyệt (đã bỏ select Priority) *@
@if (isApproveModalVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.4); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius:20px;">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" style="color:#1E293B;">Phê duyệt gian hàng</h5>
                    <button type="button" class="btn-close" @onclick="() => isApproveModalVisible = false"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small">Xác nhận duyệt gian hàng <strong>@targetPoi?.Name</strong>?</p>
                    <p class="text-muted small">Gói thành viên hiện tại: <strong>@GetTierEmoji(GetOwnerTier(targetPoi?.OwnerId)) @GetTierLabel(GetOwnerTier(targetPoi?.OwnerId))</strong></p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button class="btn btn-outline-secondary rounded-pill px-4" @onclick="() => isApproveModalVisible = false">Hủy</button>
                    <button class="btn btn-success rounded-pill px-4 fw-bold" @onclick="ApprovePoiAction">Xác nhận Duyệt</button>
                </div>
            </div>
        </div>
    </div>
}

@* Modal Admin Từ chối *@
@if (isRejectModalVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.4); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius:20px;">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" style="color:#1E293B;">Từ chối gian hàng</h5>
                    <button type="button" class="btn-close" @onclick="() => isRejectModalVisible = false"></button>
                </div>
                <div class="modal-body p-4">
                    <textarea class="form-control rounded-3" rows="3" style="background:#F8FAFC; border:1px solid #E2E8F0; color:#1E293B;" @bind="targetNote" placeholder="Lý do từ chối..."></textarea>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button class="btn btn-outline-secondary rounded-pill px-4" @onclick="() => isRejectModalVisible = false">Hủy</button>
                    <button class="btn btn-danger rounded-pill px-4 fw-bold" @onclick="RejectPoiAction">Xác nhận</button>
                </div>
            </div>
        </div>
    </div>
}

@* Modal Sửa (đã bỏ Priority) *@
@if (isModalVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.4); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
             <div class="modal-content border-0 shadow-lg" style="border-radius:24px;">
                 <div class="modal-header p-4" style="border-bottom:1px solid #E2E8F0;">
                    <h4 class="modal-title fw-bold" style="color:#1E293B;">Thông Tin Quản Trị</h4>
                    <button type="button" class="btn-close" @onclick="HideModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-4">
                        <div class="col-12">
                            <label class="form-label small fw-bold" style="color:#64748B;">TÊN GIAN HÀNG</label>
                            <input type="text" class="form-control p-3" style="background:#F8FAFC; border:1px solid #E2E8F0; color:#1E293B; border-radius:12px;" @bind="editingPoi.Name" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold" style="color:#64748B;">SỐ ĐIỆN THOẠI</label>
                            <input type="text" class="form-control p-3" style="background:#F8FAFC; border:1px solid #E2E8F0; color:#1E293B; border-radius:12px;" @bind="editingPoi.Phone" />
                        </div>
                        <div class="col-12">
                            <div class="alert mb-0" style="background:#F0F9FF;border:1px solid #BAE6FD;color:#075985;border-radius:12px;font-size:13px;">
                                <i class="bi bi-info-circle me-1"></i>
                                Bán kính geofence được hệ thống quản lý tự động: dùng giá trị mặc định
                                <strong>@DefaultRadius m</strong> rồi cộng thêm theo gói thành viên của chủ gian hàng
                                (Standard +0, Silver +5, Gold +10, Diamond +15).
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold" style="color:#64748B;">CHỦ GIAN HÀNG</label>
                            <select class="form-select p-3" style="background:#F8FAFC; border:1px solid #E2E8F0; color:#1E293B; border-radius:12px;" @bind="editingOwnerIdText">
                                <option value="">-- Chưa gán chủ --</option>
                                @foreach (var v in vendorUsers) { <option value="@v.UserId">@v.Name (@v.Email)</option> }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer p-4 border-0 pt-0">
                    <button class="btn btn-outline-secondary rounded-pill px-4" @onclick="HideModal">Hủy</button>
                    <button class="btn btn-danger rounded-pill px-5 fw-bold shadow-sm" @onclick="SavePoi" disabled="@isSaving">Lưu thay đổi</button>
                </div>
             </div>
        </div>
    </div>
}

@* Modal Xác nhận Khóa *@
@if (isHideConfirmVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.4); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius:20px;">
                <div class="modal-body p-5 text-center">
                    <i class="bi bi-lock-fill text-danger display-4 mb-4 d-block"></i>
                    <h4 class="fw-bold mb-3" style="color:#1E293B;">Khóa gian hàng?</h4>
                    <p class="text-muted mb-5">Gian hàng <strong>@hidingPoi?.Name</strong> sẽ bị tạm dừng và không hiển thị trên bản đồ.</p>
                    <div class="d-flex justify-content-center gap-3">
                        <button class="btn btn-outline-secondary rounded-pill px-4" @onclick="HideHideConfirm">Hủy</button>
                        <button class="btn btn-danger rounded-pill px-4 fw-bold" @onclick="HidePoiAsync" disabled="@isSaving">Xác nhận Khóa</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const int DefaultRadius = 20;

    private static int GetTierBonus(string tier) => tier switch
    {
        "Diamond" => 15,
        "Gold" => 10,
        "Silver" => 5,
        _ => 0
    };

    private List<Poi> pois = new();
    private List<User> vendorUsers = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private string searchText = "";
    private string filterStatus = "all";
    private string filterApproval = "all";

    private bool isModalVisible = false;
    private bool isEditing = false;
    private string errorMessage = "";
    private Poi editingPoi = new();
    private string editingOwnerIdText = "";

    private bool isHideConfirmVisible = false;
    private Poi? hidingPoi;

    private bool isApproveModalVisible = false;
    private bool isRejectModalVisible = false;
    private Poi? targetPoi;
    private string targetNote = "";

    private DotNetObjectReference<PoiList>? dotNetRef;

    private IEnumerable<Poi> FilteredPois => pois
        .Where(p => string.IsNullOrWhiteSpace(searchText) || p.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase))
        .Where(p => filterStatus == "all" || (filterStatus == "active" && p.IsActive) || (filterStatus == "inactive" && !p.IsActive))
        .Where(p => filterApproval == "all" || p.Status == filterApproval);

    protected override async Task OnInitializedAsync() { await LoadData(); }

    private async Task LoadData() {
        isLoading = true;
        pois = await PoiService.GetAllAsync();
        vendorUsers = await AuthService.GetAllUsersAsync();
        isLoading = false;
    }

    private void ShowEditModal(Poi poi) {
        isEditing = true;
        editingPoi = new Poi {
            PoiId = poi.PoiId,
            Name = poi.Name,
            Address = poi.Address,
            Phone = poi.Phone,
            Latitude = poi.Latitude,
            Longitude = poi.Longitude,
            Radius = poi.Radius,
            OwnerId = poi.OwnerId,
            IsActive = poi.IsActive,
            Status = poi.Status,
            RejectionNote = poi.RejectionNote
        };
        editingOwnerIdText = poi.OwnerId?.ToString() ?? "";
        isModalVisible = true;
    }

    private void HideModal() { isModalVisible = false; }

    private async Task SavePoi() {
        if (int.TryParse(editingOwnerIdText, out var oid)) editingPoi.OwnerId = oid; else editingPoi.OwnerId = null;
        // Bán kính dùng giá trị mặc định, runtime cộng thêm theo gói thành viên.
        editingPoi.Radius = DefaultRadius;
        isSaving = true;
        await PoiService.UpdateAsync(editingPoi);
        HideModal(); await LoadData();
        isSaving = false;
    }

    private void ShowApproveModal(Poi poi) { targetPoi = poi; isApproveModalVisible = true; }
    private async Task ApprovePoiAction() {
        if (targetPoi == null) return;
        await PoiService.ApprovePoiAsync(targetPoi.PoiId);
        isApproveModalVisible = false; await LoadData();
    }

    private void ShowRejectModal(Poi poi) { targetPoi = poi; targetNote = ""; isRejectModalVisible = true; }
    private async Task RejectPoiAction() {
        if (targetPoi == null) return;
        await PoiService.RejectPoiAsync(targetPoi.PoiId, targetNote);
        isRejectModalVisible = false; await LoadData();
    }

    private void ShowHideConfirm(Poi poi) { hidingPoi = poi; isHideConfirmVisible = true; }
    private void HideHideConfirm() { isHideConfirmVisible = false; }
    private async Task HidePoiAsync() { if (hidingPoi != null) await PoiService.HideStallAsync(hidingPoi.PoiId); HideHideConfirm(); await LoadData(); }

    private async Task ToggleActive(int id) { await PoiService.ToggleActiveAsync(id); await LoadData(); }

    private string GetOwnerLabel(int? ownerId) {
        if (ownerId == null) return "Chưa gán";
        var u = vendorUsers.FirstOrDefault(x => x.UserId == ownerId);
        return u == null ? $"User #{ownerId}" : $"{u.Name}";
    }

    private string GetOwnerTier(int? ownerId) {
        if (ownerId == null) return "Standard";
        var u = vendorUsers.FirstOrDefault(x => x.UserId == ownerId);
        return u?.MembershipTier ?? "Standard";
    }

    private string GetTierEmoji(string tier) => tier switch { "Diamond" => "💎", "Gold" => "🥇", "Silver" => "🥈", _ => "⬜" };
    private string GetTierLabel(string tier) => tier switch { "Diamond" => "Kim Cương", "Gold" => "Vàng", "Silver" => "Bạc", _ => "Thường" };
    private string GetTierBadgeStyle(string tier) => tier switch {
        "Diamond" => "background:rgba(139,92,246,0.12); color:#7C3AED; border:1px solid rgba(139,92,246,0.3); font-size:12px;",
        "Gold" => "background:rgba(234,179,8,0.12); color:#CA8A04; border:1px solid rgba(234,179,8,0.3); font-size:12px;",
        "Silver" => "background:rgba(148,163,184,0.12); color:#64748B; border:1px solid rgba(148,163,184,0.3); font-size:12px;",
        _ => "background:rgba(148,163,184,0.08); color:#94A3B8; border:1px solid rgba(148,163,184,0.2); font-size:12px;"
    };

    public async ValueTask DisposeAsync() { dotNetRef?.Dispose(); }
}

@page "/vendor/thu-nhap"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Vendor")]
@rendermode InteractiveServer

@inject NavigationManager Navigation

<div class="dash-page p-4">
    <div class="text-center py-5">
        <div class="spinner-border text-danger" style="width:2.5rem;height:2.5rem;" role="status"></div>
        <p style="color:#64748B;font-size:13px;letter-spacing:1px;margin-top:12px;">
            Đang chuyển sang Dashboard tổng hợp...
        </p>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/", replace: true);
    }
}
